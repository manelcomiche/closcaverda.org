{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    // Pin Docker base images and compose services to an immutable digest, so a
    // re-pushed tag can never swap the image underneath a build.
    'docker:pinDigests',
    // Pin GitHub Actions to commit SHAs (a moved tag cannot inject code into CI).
    'helpers:pinGitHubActionDigests',
    // Refresh transitive dependencies in the lockfile once a week.
    ':maintainLockFilesWeekly',
    ':timezone(Europe/Madrid)',
  ],

  // Regular updates arrive once a week, in a quiet window.
  schedule: ['before 7am on monday'],
  prConcurrentLimit: 5,
  labels: ['dependencies'],
  rangeStrategy: 'bump',

  // Supply-chain cooldown: ignore releases younger than 7 days. Most malicious
  // npm/PyPI publishes are caught and unpublished within that window.
  minimumReleaseAge: '7 days',
  internalChecksFilter: 'strict',

  // Security fixes are Dependabot's job (.github/dependabot.yml), so Renovate
  // does not open security PRs of its own and the two never duplicate each other.
  vulnerabilityAlerts: { enabled: false },

  // Updates marked automerge below are merged once every check on the PR has
  // passed. Renovate verifies the checks itself rather than through GitHub
  // auto-merge, so this works without branch protection. Majors and 0.x minors
  // still wait for a human (they are listed on the Dependency Dashboard).
  platformAutomerge: false,
  lockFileMaintenance: { automerge: true },

  packageRules: [
    {
      description: 'One PR per week for every non-major npm / Python update (0.x stays separate: minors can break there)',
      matchCategories: ['js', 'python'],
      matchUpdateTypes: ['minor', 'patch'],
      matchCurrentVersion: '!/^v?0\\./',
      groupName: 'non-major dependencies',
      groupSlug: 'all-minor-patch',
      automerge: true,
    },
    {
      description: 'Docker base images and compose services: digest refreshes (OS security patches) and patch bumps together',
      matchDatasources: ['docker'],
      matchUpdateTypes: ['digest', 'pinDigest', 'patch'],
      groupName: 'docker images',
      groupSlug: 'docker-images',
      automerge: true,
    },
    {
      description: 'GitHub Actions: SHA pins and their refreshes together',
      matchManagers: ['github-actions'],
      groupName: 'github actions',
      groupSlug: 'github-actions',
      automerge: true,
    },
    {
      description: 'Major GitHub Actions bumps can change deploy workflows that PR checks never run',
      matchManagers: ['github-actions'],
      matchUpdateTypes: ['major'],
      automerge: false,
    },
    {
      description: '0.x patch releases are auto-merged like any other patch',
      matchCategories: ['js', 'python'],
      matchCurrentVersion: '/^v?0\\./',
      matchUpdateTypes: ['patch'],
      automerge: true,
    },
  ],
}
